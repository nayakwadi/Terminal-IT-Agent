        <mxCell id="ticket" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F4C81;fontSize=11;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;Helpdesk ticket&lt;br&gt;(text file → ServiceNow webhook)&lt;/font&gt;" vertex="1">
