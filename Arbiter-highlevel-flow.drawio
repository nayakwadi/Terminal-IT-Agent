        </mxCell>
        <mxCell id="cross_zone" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontStyle=1;align=left;verticalAlign=top;fontSize=13;spacingLeft=10;spacingTop=8;" value="Workflow" vertex="1">
          <mxGeometry height="200" width="760" x="618" y="100" as="geometry" />
