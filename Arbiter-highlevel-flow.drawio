        <mxCell id="t1" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" value="Base Architecture for Terminal IT Agent" vertex="1">
          <mxGeometry height="36" width="1170" x="158" y="20" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" value="&lt;b&gt;&lt;font style=&quot;color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;Helpdesk ticket → IAM-gated agent runtime → Bedrock KB retrieval over S3 Vectors → Guardrails + foundation model → Response&amp;nbsp; → Adaptive Card to MS Teams.&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="1150" x="158" y="56" as="geometry" />
        </mxCell>
        <mxCell id="input_zone" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#0F4C81;strokeWidth=1;fontStyle=1;align=left;verticalAlign=top;fontSize=13;fontColor=#0F4C81;spacingLeft=10;spacingTop=8;" value="Input" vertex="1">
